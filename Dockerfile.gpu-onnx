FROM pytorch/pytorch:2.11.0-cuda12.8-cudnn9-runtime

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      libgl1 \
      libglib2.0-0 \
      libxcb1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-gpu-onnx.txt ./
RUN python -m pip install \
      --break-system-packages \
      --no-cache-dir \
      --timeout 1000 \
      -r requirements-gpu-onnx.txt

# 소스는 통째로 넣는다. 파일 단위로 나열하면 모듈이 빠진 채 발행되는 사고가
# 재발한다 (Dockerfile.rgb-defect-onnx 는 ct_defect_onnx.py 가 빠져 있었다).
COPY *.py ./

EXPOSE 8000

CMD ["python", "gpu_runtime.py"]
