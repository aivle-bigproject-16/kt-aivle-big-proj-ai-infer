        "properties": {
          "height": {
            "minimum": 0.0,
            "title": "Height",
            "type": "number"
          },
          "width": {
            "minimum": 0.0,
            "title": "Width",
            "type": "number"
          },
          "x": {
            "title": "X",
            "type": "number"
          },
          "y": {
            "title": "Y",
            "type": "number"
          }
        },
        "required": [
          "x",
          "y",
          "width",
          "height"
        ],
        "title": "BoundingBox",
        "type": "object"
      },
      "CallbackBoundingBox": {
        "additionalProperties": false,
        "description": "셀 분석 콜백의 좌표. BE DTO 에 맞춰 정수로 반올림해서 보낸다.",
        "properties": {
          "height": {
            "minimum": 0.0,
            "title": "Height",
            "type": "integer"
          },
          "width": {
            "minimum": 0.0,
            "title": "Width",
            "type": "integer"
          },
          "x": {
            "title": "X",
            "type": "integer"
          },
          "y": {
            "title": "Y",
            "type": "integer"
          }
        },
        "required": [
          "x",
          "y",
          "width",
          "height"
        ],
        "title": "CallbackBoundingBox",
        "type": "object"
      },
      "CallbackDefect": {
        "additionalProperties": false,
        "properties": {
          "bbox": {
            "$ref": "#/components/schemas/CallbackBoundingBox"
