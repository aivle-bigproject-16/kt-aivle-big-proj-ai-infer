  "info": {
    "summary": "KT AIVLE 빅프로젝트 16조 AI 추론 서버",
    "title": "ai-infer",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/ai/cells/analyze": {
      "post": {
        "callbacks": {
          "cell_analysis_callback": {
            "{$request.body.callbackUrl}": {
              "post": {
                "description": "`X-Internal-Api-Key` 를 함께 보낸다. BE 는 2xx 로 답해야 한다.\n\n2xx 가 아니면 `CALLBACK_MAX_ATTEMPTS` 까지 지수 백오프로 재시도한다.",
                "operationId": "cell_analysis_callback__request_body_callbackUrl__post",
                "requestBody": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/CellAnalysisCallback"
                      }
                    }
                  },
                  "required": true
                },
                "responses": {
                  "200": {
                    "content": {
                      "application/json": {
                        "schema": {}
                      }
                    },
                    "description": "Successful Response"
                  },
                  "422": {
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/HTTPValidationError"
                        }
                      }
                    },
                    "description": "Validation Error"
                  }
                },
                "summary": "분석 완료 후 서버가 BE 로 보내는 콜백"
              }
            }
          }
        },
        "operationId": "analyze_cell_ai_cells_analyze_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-internal-api-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Internal-Api-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CellAnalysisRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CellAnalysisAccepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "callbackUrl 이 설정된 콜백과 다릅니다"
          },
          "401": {
            "description": "X-Internal-Api-Key 불일치"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "description": "셀 분석 큐가 가득 찼습니다"
          }
        },
        "summary": "셀 1개 비동기 분석 접수",
        "tags": [
          "cell-analysis"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "서버 준비 상태와 모달별 어댑터 상세",
        "tags": [
          "ops"
        ]
      }
    },
    "/infer/ct": {
      "post": {
        "operationId": "infer_ct_infer_ct_post",
        "requestBody": {
          "content": {
            "application/json": {
