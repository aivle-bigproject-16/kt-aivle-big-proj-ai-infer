# stub | ct-quality-onnx | ct-onnx | quality-onnx | rgb-onnx | onnx
INFERENCE_MODE=stub
ONNX_DEVICE=cpu

STUB_LATENCY_MS=800
STUB_REJECT_RATE=0.3
STUB_FAIL_RATE=0.0

CT_QUALITY_MODEL_PATH=/models/quality_ct.onnx
CT_DEFECT_MODEL_PATH=/models/defect_ct.onnx
CT_POSTPROCESS_TYPE=NMS
CT_POSTPROCESS_MATCH_METRIC=IOS
CT_POSTPROCESS_MATCH_THRESHOLD=0.44
RGB_QUALITY_MODEL_PATH=/models/quality_rgb.onnx
RGB_DEFECT_MODEL_DIR=/models/rgb_owlv2_onnx

IMAGE_DOWNLOAD_TIMEOUT_SECONDS=10
IMAGE_MAX_BYTES=20971520
