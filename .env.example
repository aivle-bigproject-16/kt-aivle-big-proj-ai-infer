# stub | ct-quality-onnx | ct-onnx | quality-onnx | rgb-onnx | onnx
INFERENCE_MODE=stub
ONNX_DEVICE=cpu

STUB_LATENCY_MS=800
STUB_REJECT_RATE=0.3
STUB_FAIL_RATE=0.0

CT_QUALITY_MODEL_PATH=/models/quality_ct.onnx
CT_DEFECT_MODEL_PATH=/models/defect_ct.onnx
CT_POSTPROCESS_TYPE=NMS
CT_POSTPROCESS_MATCH_METRIC=IOS
CT_POSTPROCESS_MATCH_THRESHOLD=0.44
RGB_QUALITY_MODEL_PATH=/models/quality_rgb.onnx
RGB_DEFECT_MODEL_DIR=/models/rgb_owlv2_onnx

# 판정 임계값. 기본값은 모델 검증 시점의 운영점과 같다.
# CT_QUALITY_THRESHOLD 는 확률이 아니라 로짓이므로 음수를 받는다.
CT_QUALITY_THRESHOLD=-0.6227158308029175
CT_DEFECT_CONF_THRESHOLD=0.05
RGB_QUALITY_FAIL_THRESHOLD=0.3

IMAGE_DOWNLOAD_TIMEOUT_SECONDS=10
IMAGE_MAX_BYTES=20971520

AI_INTERNAL_API_KEY=replace-me
BACKEND_CALLBACK_URL=http://backend:8080/internal/ai/callbacks/cell
CELL_ANALYSIS_WORKERS=1
CELL_ANALYSIS_QUEUE_SIZE=4
CALLBACK_TIMEOUT_SECONDS=10
CALLBACK_MAX_ATTEMPTS=3
