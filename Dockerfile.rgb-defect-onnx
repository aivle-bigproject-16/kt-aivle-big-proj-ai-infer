FROM python:3.12-slim

WORKDIR /app

COPY requirements-rgb-defect-onnx-runtime.txt ./
RUN pip install --no-cache-dir -r requirements-rgb-defect-onnx-runtime.txt

# 소스는 통째로 넣는다. 파일 단위로 나열하면 모듈이 빠진 채 발행되는 사고가
# 재발한다 (Dockerfile.rgb-defect-onnx 는 ct_defect_onnx.py 가 빠져 있었다).
COPY *.py ./

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
