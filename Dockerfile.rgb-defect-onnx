FROM python:3.12-slim

WORKDIR /app

COPY requirements-rgb-defect-onnx-runtime.txt ./
RUN pip install --no-cache-dir -r requirements-rgb-defect-onnx-runtime.txt

COPY main.py downloader.py adapters.py schemas.py settings.py adapter_factory.py ./
COPY onnx_quality_ct.py onnx_quality_rgb.py ./
COPY rgb_ext_infer.py rgb_ext_infer_onnx.py rgb_owlv2_defect.py ./

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
